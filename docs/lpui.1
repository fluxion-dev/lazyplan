.SH EXAMPLES
.nf
lpui                             # TUI (same as `lpui ui`)
lpui list                        # ascii tree
lpui list --status doing --priority p0
lpui show --kind project --id 1
lpui --actor alice add-project --title \(dqAPI v2\(dq --why \(dq..\(dq --priority p1
lpui --actor alice add-criteria --kind project --id 1 --text \(dqWorks offline\(dq
lpui --actor alice add-task --story 1 --title \(dqFix bug\(dq --priority p1
lpui status --kind task --id 3 --to done
lpui feed --limit 20
lpui export --format json > backup.json
lpui import --file backup.json
.fi
.SH ENVIRONMENT
.TP
.B LAZYPLAN_DB
SQLite path override (same as \fB\-\-db\fR).
.TP
.B USER
Default for \fB\-\-actor\fR when not given.
.SH FILES
.TP
.B .lazyplan/lazyplan.db
Per\-repo database (resolved via git rev\-parse; commit it to share).
.TP
.B ~/.local/share/lazyplan/lazyplan.db
Global fallback when outside a repo.
.SH EXIT STATUS
.TP
.B 0
Success.
.TP
.B 1
Row not found (e.g. task #7 not found).
.TP
.B 2
Usage or validation error (argparse or error: ... on stderr).
.TP
.B 3
TUI unavailable (Textual not installed).
