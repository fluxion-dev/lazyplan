/* Shell layout: the plan tree, the preview/GIT column, and the timeline. */

#panel {
    height: 1fr;
}

#main {
    height: 1fr;
    padding: 0 0 0 1;
}

#nav {
    width: 45%;
    min-width: 28;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    border-title-style: bold;
    border-title-align: left;
}

#side {
    width: 1fr;
    min-width: 34;
}

#preview {
    width: 1fr;
    height: 1fr;
    min-height: 8;
    padding: 0 1;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    border-title-style: bold;
    border-title-align: left;
}

#preview-scroll {
    height: 1fr;
}

#preview-head {
    height: auto;
    max-height: 4;
    padding: 0 1;
    background: $lp-surface-alt;
}

#preview-body {
    height: auto;
    padding: 0 1;
}

#git {
    width: 1fr;
    height: auto;
    min-height: 3;
    max-height: 10;
    padding: 0 1;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    border-title-style: bold;
    border-title-align: left;
}

#git-body {
    height: auto;
    padding: 0 1;
}

#metrics {
    height: 40%;
    min-height: 11;
    max-height: 16;
    padding: 0;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    border-title-style: bold;
}

#hints {
    width: 100%;
    height: 1;
    background: $lp-surface-alt;
    color: $lp-text-muted;
    padding: 0 2;
}

#main.narrow #side,
#main.narrow #preview,
#main.narrow #git {
    display: none;
}

#main.narrow #nav {
    width: 100%;
}

#metrics.narrow {
    display: none;
}

#main.compact {
    padding: 0;
}

#main.compact #nav {
    min-width: 0;
    border: none;
}

#main.wide #preview,
#main.wide #git {
    padding: 0 2;
}

#nav:focus-within,
#preview:focus-within {
    border: round $lp-border-focus;
    border-title-color: $lp-border-focus;
}

Screen.compact #hints {
    padding: 0 1;
}

Screen.compact #dlg {
    width: 96%;
    padding: 0 1;
}

Screen.wide #dlg {
    max-width: 84;
}
