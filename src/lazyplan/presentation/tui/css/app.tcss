/* Shell layout: the plan tree, the preview/GIT column, and the timeline. */

#panel {
    height: 1fr;
}

#main {
    height: 1fr;
    padding: 0 0 0 1;
}

#left {
    width: 1fr;
    min-width: 28;
    height: 1fr;
}

#nav {
    width: 1fr;
    height: 1fr;
    border: none;
    padding: 0;
}

.plan-panel {
    width: 1fr;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    border-title-style: bold;
    border-title-align: left;
}

#plans-active {
    height: 3fr;
}

#plans-finished {
    height: 2fr;
}

#side {
    width: 1fr;
    min-width: 34;
}

#preview {
    width: 1fr;
    height: 1fr;
    min-height: 8;
    padding: 0 1;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    border-title-style: bold;
    border-title-align: left;
}

#preview-scroll {
    height: 1fr;
}

#preview-head {
    height: auto;
    max-height: 4;
    padding: 0 1;
    background: $lp-surface-alt;
}

#preview-strip {
    height: auto;
    max-height: 3;
    padding: 0 1;
    background: $lp-surface;
}

#preview-body {
    height: auto;
    padding: 0 1;
}

#git {
    width: 1fr;
    height: auto;
    min-height: 3;
    max-height: 10;
    padding: 0 1;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    border-title-style: bold;
    border-title-align: left;
}

#git-body {
    height: auto;
    padding: 0 1;
}

#agents {
    width: 1fr;
    height: auto;
    min-height: 3;
    max-height: 8;
    padding: 0 1;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    border-title-style: bold;
    border-title-align: left;
}

#agents-body {
    height: auto;
    padding: 0 1;
}

#metrics {
    height: 40%;
    min-height: 11;
    max-height: 16;
    padding: 0;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    border-title-style: bold;
}

#hints {
    width: 100%;
    height: 1;
    background: $lp-surface-alt;
    color: $lp-text-muted;
    padding: 0 2;
}

#main.narrow {
    layout: vertical;
}

#main.narrow #preview,
#main.narrow #plans-finished {
    display: none;
}

#main.narrow #left,
#main.narrow #nav,
#main.narrow #plans-active,
#main.narrow #side,
#main.narrow #git {
    width: 100%;
}

#main.narrow #left {
    height: 1fr;
}

#main.narrow #side {
    height: auto;
}

#main.narrow #git {
    min-width: 0;
    max-height: 6;
}

#main.narrow #agents {
    max-height: 5;
}

#main.compact {
    padding: 0;
}

#main.compact #left {
    min-width: 0;
}

#main.compact #nav,
#main.compact .plan-panel {
    min-width: 0;
}

#main.compact .plan-panel {
    border: none;
}

#main.wide #preview,
#main.wide #git,
#main.wide #agents {
    padding: 0 2;
}

.plan-panel:focus-within,
#preview:focus-within {
    border: round $lp-border-focus;
    border-title-color: $lp-border-focus;
}

Screen.compact #hints {
    padding: 0 1;
}

Screen.compact #dlg {
    width: 96%;
    padding: 0 1;
}

Screen.wide #dlg {
    max-width: 84;
}
