/* Screen and modal chrome. Scope everything to a screen id. */

ModalScreen {
    align: center middle;
    background: $lp-overlay;
}

#dlg {
    width: 90%;
    max-width: 72;
    height: auto;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-modal-bg;
    padding: 1 2;
}

#dlg:focus-within {
    border: round $lp-border-focus;
}

#dlg .form-title {
    height: 1;
    color: $lp-accent;
    text-style: bold;
    margin-bottom: 1;
}

#dlg .field-label {
    height: 1;
    color: $lp-text-muted;
}

#dlg Input,
#dlg Select {
    width: 100%;
    height: 3;
    border: tall $lp-border;
}

#dlg TextArea {
    width: 100%;
    height: 5;
    border: tall $lp-border;
    background: $lp-surface;
}

#f-why, #f-what {
    height: 4;
}

#dlg.export-dialog {
    max-width: 84;
}

#export-path {
    border: tall $lp-border;
}

#export-tree-scroll {
    height: 9;
    padding: 0 1;
    border: round $lp-border-muted;
}

#export-tree {
    background: transparent;
    padding: 0;
}

#export-error {
    height: auto;
    min-height: 1;
    color: $lp-status-blocked;
}

#dlg #palette-scroll {
    height: auto;
    max-height: 16;
}

#help {
    width: 90%;
    height: 90%;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-modal-bg;
    padding: 1 2;
}

#help-scroll {
    height: 1fr;
}

#source-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#source-head {
    height: auto;
    min-height: 2;
    background: $lp-surface;
    color: $lp-accent;
    padding: 0 1;
    margin-bottom: 1;
}

#source-filter {
    height: 3;
}

#source-main {
    height: 1fr;
}

#source-tree-wrap {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#source-preview {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#source-preview-body {
    height: auto;
}

#source-tree-wrap:focus-within,
#source-preview:focus-within {
    border: round $lp-border-focus;
}

#dlg Button, #help Button {
    min-width: 0;
    width: auto;
    height: 1;
    padding: 0 1;
    border: none;
}

#dlg .btn-row Button {
    margin-right: 1;
}

#palette-title {
    color: $lp-accent;
    text-style: bold;
}

#palette-list > .option-list--option {
    padding: 0 1;
}

#palette-list > .option-list--option-highlighted {
    background: $lp-cursor;
    color: $lp-accent;
    text-style: bold;
}

#palette-list > .option-list--option-disabled {
    color: $lp-text-faint;
}

#update-body {
    padding: 1 0;
}

#hub-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#hub-main {
    height: 1fr;
}

#hub-list-wrap {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#hub-preview {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#hub-preview-body {
    height: auto;
}

#hub-list-wrap:focus-within,
#hub-preview:focus-within {
    border: round $lp-border-focus;
}

#hub-list > .option-list--option {
    padding: 0 1;
}

#hub-list > .option-list--option-highlighted {
    background: $lp-cursor;
    color: $lp-accent;
    text-style: bold;
}

#hub-hints {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $lp-surface;
    color: $lp-text-muted;
}
