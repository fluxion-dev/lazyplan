/* Screen and modal chrome. Scope everything to a screen id. */

ModalScreen {
    align: center middle;
    background: $lp-overlay;
}

#dlg {
    width: 90%;
    max-width: 72;
    height: auto;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-modal-bg;
    padding: 1 2;
}

#dlg:focus-within {
    border: round $lp-border-focus;
}

#dlg .form-title {
    height: 1;
    color: $lp-accent;
    text-style: bold;
    margin-bottom: 1;
}

#dlg .field-label {
    height: 1;
    color: $lp-text-muted;
}

#dlg Input {
    width: 100%;
    height: 3;
    border: tall $lp-border;
}

#dlg TextArea {
    width: 100%;
    height: 5;
    border: tall $lp-border;
    background: $lp-surface;
}

#dlg.entity-form {
    width: 92%;
    max-width: 120;
}

Screen.wide #dlg.entity-form {
    max-width: 120;
}

#dlg.form-tall {
    height: 88%;
}

#dlg.form-tall TextArea {
    height: 1fr;
    min-height: 8;
}

Screen.compact #dlg.entity-form {
    width: 96%;
}

Screen.short #dlg.form-tall {
    height: 96%;
}

Screen.short #dlg.form-tall TextArea {
    min-height: 3;
}

#dlg.export-dialog {
    max-width: 84;
}

#export-path {
    border: tall $lp-border;
}

#export-tree-scroll {
    height: 9;
    padding: 0 1;
    border: round $lp-border-muted;
}

#export-tree {
    background: transparent;
    padding: 0;
}

#export-error {
    height: auto;
    min-height: 1;
    color: $lp-status-blocked;
}

#dlg #palette-scroll {
    height: auto;
    max-height: 16;
}

#help {
    width: 90%;
    height: 90%;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-modal-bg;
    padding: 1 2;
}

#help-scroll {
    height: 1fr;
}

#source-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#source-head {
    height: auto;
    min-height: 2;
    background: $lp-surface;
    color: $lp-accent;
    padding: 0 1;
    margin-bottom: 1;
}

#source-filter {
    height: 3;
}

#source-main {
    height: 1fr;
}

#source-tree-wrap {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#source-preview {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

Screen.stacked #source-main {
    layout: vertical;
}

Screen.stacked #source-tree-wrap {
    width: 100%;
    min-width: 0;
    height: 2fr;
    min-height: 6;
}

Screen.stacked #source-preview {
    width: 100%;
    min-width: 0;
    height: 3fr;
    min-height: 8;
}

Screen.compact #source-head {
    min-height: 2;
    margin-bottom: 0;
}

#source-preview-body {
    height: auto;
}

#source-tree {
    scrollbar-size-horizontal: 0;
}

#plan-diff-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#plan-diff-head {
    height: auto;
    min-height: 2;
    background: $lp-surface;
    color: $lp-accent;
    padding: 0 1;
    margin-bottom: 1;
}

#plan-diff-scroll {
    height: 1fr;
    padding: 0 1;
}

#plan-diff-body {
    height: auto;
}

#plan-diff-hints {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $lp-surface;
    color: $lp-text-muted;
}

#source-hints {
    width: 100%;
    height: auto;
    max-height: 2;
    padding: 0 1;
    background: $lp-surface;
    color: $lp-text-muted;
    text-wrap: wrap;
}

#source-tree-wrap:focus-within,
#source-preview:focus-within {
    border: round $lp-border-focus;
}

#dlg Button, #help Button {
    min-width: 0;
    width: auto;
    height: 1;
    padding: 0 1;
    border: none;
}

#dlg .btn-row Button {
    margin-right: 1;
}

#palette-title {
    color: $lp-accent;
    text-style: bold;
}

#palette-list > .option-list--option {
    padding: 0 1;
}

#palette-list > .option-list--option-highlighted {
    background: $lp-cursor;
    color: $lp-accent;
    text-style: bold;
}

#palette-list > .option-list--option-disabled {
    color: $lp-text-faint;
}

#update-body {
    padding: 1 0;
}

#hub-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#hub-main {
    height: 1fr;
}

#hub-list-wrap {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#hub-preview {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#hub-preview-body {
    height: auto;
}

#hub-list-wrap:focus-within,
#hub-preview:focus-within {
    border: round $lp-border-focus;
}

#hub-list > .option-list--option {
    padding: 0 1;
}

#hub-list > .option-list--option-highlighted {
    background: $lp-cursor;
    color: $lp-accent;
    text-style: bold;
}

#hub-hints {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $lp-surface;
    color: $lp-text-muted;
}

#setup-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#setup-head {
    height: auto;
    max-height: 6;
    background: $lp-surface;
    padding: 0 1;
    margin-bottom: 1;
}

#setup-counter {
    height: 1;
    color: $lp-text-muted;
}

#setup-step-title {
    height: 1;
    color: $lp-accent;
    text-style: bold;
}

#setup-copy {
    height: auto;
    max-height: 3;
    color: $lp-text-muted;
    text-wrap: wrap;
}

#setup-main {
    height: 1fr;
}

#setup-rail {
    width: 26;
    min-width: 18;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
    margin-right: 1;
}

#setup-rail-list {
    height: auto;
    background: transparent;
    padding: 0;
}

#setup-rail-list > .option-list--option {
    padding: 0 1;
}

#setup-rail-list > .option-list--option-highlighted {
    background: $lp-cursor;
    color: $lp-accent;
    text-style: bold;
}

#setup-content {
    width: 1fr;
    padding: 0 1;
}

#setup-panel {
    height: auto;
}

#setup-panel .setup-label {
    height: 1;
    color: $lp-text-muted;
    margin-top: 1;
}

#setup-panel .setup-note {
    height: auto;
    color: $lp-text-muted;
    padding: 1 0 0 0;
}

#setup-panel .setup-choice {
    height: auto;
    padding: 1 0 0 1;
}

#setup-placement-list {
    height: auto;
    background: transparent;
    padding: 0;
}

#setup-placement-list > .option-list--option {
    padding: 0 1;
}

#setup-placement-list > .option-list--option-highlighted {
    background: $lp-cursor;
    color: $lp-accent;
    text-style: bold;
}

#setup-panel Checkbox {
    height: auto;
    min-height: 1;
    margin: 0;
}

#setup-panel .setup-host {
    height: auto;
    color: $lp-accent;
    padding: 1 0 0 0;
}

#setup-panel .setup-item {
    height: auto;
    padding: 1 0 0 0;
}

#setup-panel .setup-checks {
    height: auto;
    padding: 0;
}

#setup-panel .setup-list {
    height: auto;
    padding: 0 0 0 1;
}

#setup-panel .setup-apply-status {
    height: auto;
    padding: 1 0 0 0;
}

#setup-panel .setup-row {
    height: auto;
    margin: 0 0 1 0;
}

#setup-panel .setup-row-label {
    width: 14;
    height: 3;
    content-align: left middle;
    color: $lp-text-muted;
}

#setup-panel .setup-row Select {
    width: 2fr;
}

#setup-panel .setup-row Input {
    width: 2fr;
}

Screen.compact #setup-panel .setup-row {
    layout: vertical;
}

Screen.compact #setup-panel .setup-row-label {
    width: 100%;
    height: 1;
}

Screen.compact #setup-panel .setup-row Select,
Screen.compact #setup-panel .setup-row Input {
    width: 100%;
}

#setup-panel Button {
    min-width: 0;
    width: auto;
    height: 1;
    padding: 0 1;
    border: none;
}

#setup-errors {
    height: auto;
    color: $lp-status-blocked;
    padding: 0 1;
}

#setup-hints {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $lp-surface;
    color: $lp-text-muted;
}

#setup-actions {
    height: auto;
    padding: 0 1;
}

#setup-actions Button {
    min-width: 0;
    width: auto;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    border: none;
}

#setup-page Input {
    height: 3;
    border: tall $lp-border;
}

#setup-page Select {
    width: 1fr;
    height: 3;
    border: none;
}

Screen.compact #setup-page {
    border: none;
    padding: 0;
}

Screen.compact #setup-rail {
    display: none;
}

Screen.compact #setup-head {
    max-height: 5;
    margin-bottom: 0;
}

Screen.compact #setup-copy {
    max-height: 2;
}

Screen.wide #setup-rail {
    width: 30;
}

Screen.short #setup-head {
    max-height: 3;
}

Screen.short #setup-copy {
    max-height: 1;
}
