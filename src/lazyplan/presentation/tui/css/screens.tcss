/* Screen and modal chrome. Scope everything to a screen id. */

ModalScreen {
    align: center middle;
    background: $lp-overlay;
}

#dlg {
    width: 90%;
    max-width: 72;
    height: auto;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-modal-bg;
    padding: 1 2;
}

#dlg:focus-within {
    border: round $lp-border-focus;
}

#dlg .form-title {
    height: 1;
    color: $lp-accent;
    text-style: bold;
    margin-bottom: 1;
}

#dlg .field-label {
    height: 1;
    color: $lp-text-muted;
}

#dlg TextArea {
    height: 4;
}

#f-why, #f-what {
    height: 3;
}

#dlg.export-dialog {
    max-width: 84;
}

#export-path {
    border: tall $lp-border;
}

#export-tree-scroll {
    height: 9;
    padding: 0 1;
    border: round $lp-border-muted;
}

#export-tree {
    background: transparent;
    padding: 0;
}

#export-error {
    height: auto;
    min-height: 1;
    color: $lp-status-blocked;
}

#dlg #palette-scroll {
    height: auto;
    max-height: 16;
}

#help {
    width: 90%;
    height: 90%;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-modal-bg;
    padding: 1 2;
}

#help-scroll {
    height: 1fr;
}

#detail-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#detail-head {
    height: auto;
    min-height: 1;
    background: $lp-surface;
    color: $lp-accent;
    padding: 0 1;
    margin-bottom: 1;
}

#detail-read {
    height: 1fr;
    padding: 0 1;
}

#detail-edit {
    height: 1fr;
    padding: 1 2;
}

#detail-edit .form-title {
    height: 1;
    color: $lp-accent;
    text-style: bold;
    margin-bottom: 1;
}

#detail-edit .field-label {
    height: 1;
    color: $lp-text-muted;
    margin-top: 1;
}

#detail-edit Input {
    border: tall $lp-border;
}

#detail-edit TextArea {
    height: 5;
    border: tall $lp-border;
}

#detail-edit .btn-row {
    height: auto;
    margin-top: 1;
}

#detail-hints {
    height: 1;
    background: $lp-surface;
    color: $lp-text-muted;
    padding: 0 1;
}

#source-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#source-head {
    height: auto;
    min-height: 2;
    background: $lp-surface;
    color: $lp-accent;
    padding: 0 1;
    margin-bottom: 1;
}

#source-filter {
    height: 3;
}

#source-main {
    height: 1fr;
}

#source-tree-wrap {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#source-preview {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#source-preview-body {
    height: auto;
}

#source-tree-wrap:focus-within,
#source-preview:focus-within {
    border: round $lp-border-focus;
}

#dlg Button, #help Button, #detail-page Button {
    min-width: 0;
    width: auto;
    height: 3;
    padding: 0 1;
}

#palette-title {
    color: $lp-accent;
    text-style: bold;
}

#palette-list > .option-list--option {
    padding: 0 1;
}

#palette-list > .option-list--option-highlighted {
    background: $lp-cursor;
    color: $lp-accent;
    text-style: bold;
}

#palette-list > .option-list--option-disabled {
    color: $lp-text-faint;
}

#update-body {
    padding: 1 0;
}

#hub-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#hub-head {
    height: auto;
    min-height: 1;
    background: $lp-surface;
    color: $lp-accent;
    padding: 0 1;
    margin-bottom: 1;
}

#hub-main {
    height: 1fr;
}

#hub-list-wrap {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#hub-preview {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#hub-preview-body {
    height: auto;
}

#hub-list-wrap:focus-within,
#hub-preview:focus-within {
    border: round $lp-border-focus;
}

#hub-list > .option-list--option {
    padding: 0 1;
}

#hub-list > .option-list--option-highlighted {
    background: $lp-cursor;
    color: $lp-accent;
    text-style: bold;
}

#agent-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#agent-head {
    height: auto;
    min-height: 2;
    background: $lp-surface;
    color: $lp-accent;
    padding: 0 1;
    margin-bottom: 1;
}

#agent-scroll {
    height: 1fr;
    border: round $lp-border-muted;
    border-title-color: $lp-text-muted;
    padding: 0 1;
}

#agent-transcript {
    height: auto;
    padding: 0 1;
}

#agent-status {
    height: 1;
    background: $lp-surface;
    color: $lp-text-muted;
    padding: 0 1;
}

#agent-prompt {
    height: 4;
    border: tall $lp-border;
}

#agent-actions {
    height: auto;
    margin-top: 1;
}

#agent-permission {
    width: 90%;
    max-width: 84;
    height: auto;
    max-height: 80%;
    border: round $lp-border-focus;
    border-title-color: $lp-accent;
    background: $lp-modal-bg;
    padding: 1 2;
}

#agent-permission-scroll {
    height: auto;
    max-height: 24;
}

#agent-permission-body {
    height: auto;
}

#proposal-page {
    height: 1fr;
    border: round $lp-border;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#proposal-head {
    height: auto;
    min-height: 1;
    background: $lp-surface;
    color: $lp-accent;
    padding: 0 1;
}

#proposal-main {
    height: 1fr;
}

#proposal-list {
    width: 1fr;
    min-width: 28;
    border: round $lp-border-muted;
    padding: 0 1;
}

#proposal-preview-scroll {
    width: 1fr;
    border: round $lp-border-muted;
    padding: 0 1;
}

#proposal-preview {
    height: auto;
}

#proposal-actions {
    height: auto;
    margin-top: 1;
}

#agent-finish {
    width: 80%;
    max-width: 72;
    height: auto;
    border: round $lp-border-focus;
    border-title-color: $lp-accent;
    background: $lp-modal-bg;
    padding: 1 2;
}

#finish-summary {
    height: 4;
    border: tall $lp-border;
}

#finish-handoff {
    border: tall $lp-border;
}

#agent-picker {
    width: 80%;
    max-width: 72;
    height: auto;
    max-height: 24;
    border: round $lp-border-focus;
    border-title-color: $lp-accent;
    background: $lp-modal-bg;
    padding: 1 2;
}

#agent-picker-head {
    height: auto;
    margin-bottom: 1;
}

#agent-picker-list {
    height: auto;
    max-height: 14;
}
