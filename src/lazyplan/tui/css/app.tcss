/* Shell layout: the top-level regions and the responsive breakpoint. */

#panel {
    height: 1fr;
    border: solid $lp-border;
}

#main {
    height: 1fr;
}

#nav {
    width: 1fr;
    min-width: 30;
    border-right: solid $lp-border;
}

#preview {
    width: 1fr;
    min-width: 30;
    padding: 0 1;
    border: round $lp-border-muted;
    border-title-color: $lp-accent;
}

#main.narrow #preview {
    display: none;
}

#main.narrow #nav {
    border-right: none;
}

#metrics {
    height: 13;
    padding: 0 1;
}

#metrics.narrow {
    display: none;
}

#preview-body {
    height: auto;
}

#status {
    height: 1;
    background: $lp-surface;
    color: $text;
    padding: 0 1;
}

#hints {
    height: 1;
    background: $lp-surface-alt;
    color: $lp-text-muted;
    padding: 0 1;
}

#panel.compact {
    border: none;
}

#main.compact #nav {
    min-width: 0;
}

#main.wide #nav {
    width: 3fr;
}

#main.wide #preview {
    width: 2fr;
    padding: 0 2;
}

Screen.compact #status, Screen.compact #hints {
    padding: 0;
}

Screen.compact #dlg {
    width: 96%;
    padding: 0 1;
}

Screen.wide #dlg {
    max-width: 84;
}
