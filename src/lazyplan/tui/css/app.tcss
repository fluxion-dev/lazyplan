/* Shell layout: the top-level regions and the responsive breakpoint. */

#panel {
    height: 1fr;
}

#main {
    height: 1fr;
}

#nav {
    width: 35%;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-accent;
    border-title-background: $lp-surface-alt;
    border-title-style: bold;
    border-title-align: left;
}

#preview {
    width: 1fr;
    min-width: 30;
    padding: 0 1;
    border: round $lp-border-muted;
    border-title-color: $lp-accent;
    border-title-background: $lp-surface-alt;
    border-title-style: bold;
    border-title-align: left;
}

#main.narrow #preview {
    display: none;
}

#main.narrow #nav {
    width: 100%;
    border: round $lp-border-muted;
}

#metrics {
    height: 45%;
    min-height: 14;
    padding: 0;
    border: round $lp-border-muted;
}

#metrics.narrow {
    display: none;
}

#preview-body {
    height: auto;
}

#hints {
    width: 100%;
    height: 1;
    background: $lp-surface-alt;
    color: $lp-text-muted;
    padding: 0 1;
}

#main.compact #nav {
    min-width: 0;
    border: none;
}

#main.wide #preview {
    padding: 0 2;
}

#nav:focus-within, #preview:focus-within {
    border: round $lp-accent;
    border-title-color: $lp-accent;
}

Screen.compact #hints {
    padding: 0;
}

Screen.compact #dlg {
    width: 96%;
    padding: 0 1;
}

Screen.wide #dlg {
    max-width: 84;
}
