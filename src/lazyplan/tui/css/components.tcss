/* Reusable card and action-row pieces. */

#metric-cards {
    height: 1fr;
}

.metric-card {
    width: 1fr;
    height: 1fr;
    padding: 0;
    margin: 0;
    background: $lp-surface;
}

#metric-timeline-scroll {
    height: 1fr;
}

.btn-row {
    width: 1fr;
    height: auto;
}

#tree {
    background: $lp-surface-alt;
    color: $foreground;
}

#tree-empty {
    width: 1fr;
    height: 1fr;
    display: none;
    content-align: center middle;
    text-align: center;
    color: $lp-text-muted;
}

#tree > .tree--guides {
    color: $lp-border-muted;
}

#tree > .tree--guides-hover {
    color: $lp-accent-muted;
}

#tree > .tree--guides-selected {
    color: $lp-accent-muted;
}

#tree > .tree--highlight-line {
    background: $lp-surface-raised;
}

#tree > .tree--cursor {
    background: $lp-surface-raised;
    color: $foreground;
    text-style: bold;
}

#tree:focus > .tree--cursor {
    background: $lp-accent-muted;
    color: $lp-surface-alt;
    text-style: bold;
}

.preview-empty {
    color: $lp-text-muted;
    padding: 1 2;
}

.preview-error {
    color: $lp-status-blocked;
    padding: 1 2;
}
