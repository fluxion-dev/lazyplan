/* Screen and modal chrome. Scope everything to a screen id. */

ModalScreen {
    align: center middle;
}

#dlg {
    width: 90%;
    max-width: 72;
    height: auto;
    border: round $lp-border-muted;
    border-title-color: $lp-accent;
    background: $lp-surface;
    padding: 1 2;
}

#dlg .form-title {
    height: 1;
    color: $lp-accent;
    text-style: bold;
    margin-bottom: 1;
}

#dlg .field-label {
    height: 1;
    color: $lp-text-muted;
}

#dlg TextArea {
    height: 4;
}

#f-why, #f-what {
    height: 3;
}

#dlg #palette-scroll {
    height: auto;
    max-height: 16;
}

#help {
    width: 90%;
    height: 90%;
    border: round $lp-border-muted;
    border-title-color: $lp-accent;
    background: $lp-surface;
    padding: 1 2;
}

#help-scroll {
    height: 1fr;
}

#detail-page {
    height: 1fr;
    border: round $lp-border-muted;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#detail-head {
    height: 1;
    background: $lp-surface;
    color: $lp-accent;
    padding: 0 1;
}

#detail-read {
    height: 1fr;
    padding: 0 1;
}

#detail-edit {
    height: 1fr;
    padding: 1 2;
}

#detail-edit .form-title {
    height: 1;
    color: $lp-accent;
    text-style: bold;
    margin-bottom: 1;
}

#detail-edit .field-label {
    height: 1;
    color: $lp-text-muted;
    margin-top: 1;
}

#detail-edit Input {
    border: tall $lp-border;
}

#detail-edit TextArea {
    height: 5;
    border: tall $lp-border;
}

#detail-edit .btn-row {
    height: auto;
    margin-top: 1;
}

#detail-hints {
    height: 1;
    background: $panel;
    color: $lp-text-muted;
    padding: 0 1;
}

#source-page {
    height: 1fr;
    border: round $lp-border-muted;
    border-title-color: $lp-accent;
    background: $lp-surface-alt;
    padding: 0 1;
}

#source-head {
    height: 3;
    background: $lp-surface;
    color: $lp-accent;
    padding: 0 1;
}

#source-filter {
    height: 3;
}

#source-main {
    height: 1fr;
}

#source-tree-wrap {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-accent;
    padding: 0 1;
}

#source-preview {
    width: 1fr;
    min-width: 30;
    border: round $lp-border-muted;
    border-title-color: $lp-accent;
    padding: 0 1;
}

#source-preview-body {
    height: auto;
}

#dlg Button, #help Button, #detail-page Button {
    min-width: 0;
    width: auto;
    height: 3;
    padding: 0 1;
}

#palette-title {
    color: $lp-accent;
    text-style: bold;
}

#palette-list > .option-list--option {
    padding: 0 1;
}

#palette-list > .option-list--option-highlighted {
    background: $lp-accent-muted;
    color: $lp-surface-alt;
    text-style: bold;
}

#palette-list > .option-list--option-disabled {
    color: $lp-text-faint;
}

#update-body {
    padding: 1 0;
}
